# =============================================================================
# Autonomous Software Engineering Team — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# Loaded by config/settings.py.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (local Ollama — no API key required for the default local backend)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.0

# Credentials for the primary reasoning model (README "Required Environment
# Variables"). Unused by the local Ollama backend; populate only when pointing
# the agents at a hosted/authenticated model endpoint.
LLM_API_KEY=

# Ollama's own context default is 2048 and it truncates prompts silently, so set
# this explicitly to what your model and GPU can hold.
OLLAMA_NUM_CTX=16384
# Must be bounded: -1 lets a small model generate until the context fills, which
# in practice means a request that never returns.
OLLAMA_NUM_PREDICT=4096
# No chat model here has a timeout of its own; without this a stalled generation
# blocks the workflow indefinitely.
LLM_TIMEOUT=300

# -----------------------------------------------------------------------------
# Per-agent models
# -----------------------------------------------------------------------------
# The five roles do not need equal capability. Generating a backlog or a small
# source file is comfortable for a 3B local model; *judging* a diff is not -- a
# model too small to review reliably invents blocking findings the Developer
# cannot act on, so the review loop never converges and the run halts on
# MAX_REVIEW_ITERATIONS. Point only the judgment-heavy roles at a stronger model.
#
# Format: "<node>=<provider>:<model>" pairs. Providers: ollama (default; may be
# omitted), gemini (alias google), groq. A bare value is an Ollama tag, so
# "qwen2.5-coder:3b" still works despite its colon.
#
# AGENT_MODELS=code_reviewer_agent=gemini:gemini-2.5-flash,qa_agent=gemini:gemini-2.5-flash
AGENT_MODELS=

# Free key from https://aistudio.google.com/apikey — only needed if an
# AGENT_MODELS entry names gemini.
GEMINI_API_KEY=

# Free key from https://console.groq.com/keys — only needed for "groq:" specs,
# and also needs `pip install langchain-groq`.
GROQ_API_KEY=

# Reply cap for hosted models, mirroring OLLAMA_NUM_PREDICT.
HOSTED_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# GitHub — repository cloning, branch creation, PR management
#   Used by: tools/github_client.py (Developer Agent, Code Reviewer Agent)
#   Token scopes: repo (contents:write, pull_requests:write)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main
# Optional — GitHub Enterprise Server only
GITHUB_API_URL=https://api.github.com

# -----------------------------------------------------------------------------
# Jira — backlog of record: epics, stories, acceptance criteria, bugs
#   Used by: tools/jira_client.py (PM, Solution Architect, Developer, QA)
# -----------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_PROJECT_KEY=PROJ

# Issue type names vary between Jira project templates.
JIRA_EPIC_ISSUE_TYPE=Epic
JIRA_STORY_ISSUE_TYPE=Story
JIRA_BUG_ISSUE_TYPE=Bug

# Optional: custom field id holding acceptance criteria, e.g. customfield_10036.
# When unset, criteria are stored in a marked block in the story description and
# parsed back from there — QA must be able to recover the PM's originals either way.
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# Optional: the issue that carries the architecture doc and dev plan as
# attachments. Defaults to the first Epic the PM Agent creates.
JIRA_DESIGN_ISSUE_KEY=

# Maps this system's story statuses onto the project's workflow status names.
# An unmapped status is skipped with a warning rather than failing the run.
JIRA_STATUS_MAP=IN_PROGRESS=In Progress,IN_REVIEW=In Review,IN_QA=In Review,DONE=Done,BLOCKED=Blocked

# -----------------------------------------------------------------------------
# SonarQube — static analysis quality gate
#   Used by: tools/testing_tools.py (Code Reviewer Agent)
# -----------------------------------------------------------------------------
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=

# The Web API cannot start an analysis — the scanner CLI does. Must be on PATH
# or given as an absolute path. A missing scanner forces SonarQube into dry-run.
SONAR_SCANNER_PATH=sonar-scanner
SONAR_SCAN_TIMEOUT=900

# -----------------------------------------------------------------------------
# Retry / iteration hard limits (docs/agents/00-orchestration-and-routing.md §3)
# Enforced by LangGraph, never by an agent. Breach => workflow_status = HALTED.
# -----------------------------------------------------------------------------
MAX_DEV_ATTEMPTS=3
MAX_REVIEW_ITERATIONS=3
MAX_QA_ITERATIONS=2
MAX_TOOL_RETRIES=3

# -----------------------------------------------------------------------------
# QA — target the merged build under test (Playwright / API test runner)
# -----------------------------------------------------------------------------
QA_BASE_URL=http://localhost:8000

# QA specs: `<story-id>.json` holds API cases, `<story-id>.ui.json` holds
# Playwright flows. A story with no spec is reported as skipped, never as passing.
QA_SPEC_DIR=tests/qa
QA_UI_TIMEOUT=30

# A story with no executable acceptance test gives QA no objective evidence.
# true (default) refuses to pass what it could not verify; false lets the
# model's judgment against the criteria stand in (demos only).
QA_FAIL_WITHOUT_SPECS=true

# -----------------------------------------------------------------------------
# Developer self-validation
# -----------------------------------------------------------------------------
# The spec's step is "run the application and unit tests" — which executes
# model-authored code on this machine, so it is opt-in. With this off,
# self-validation is a parse check over the generated files plus the model's own
# reported judgment.
DEV_RUN_TESTS=false
DEV_TEST_COMMAND=pytest -q
DEV_WORKSPACE=.dev-workspace

# Largest PR diff handed to the reviewer model, in characters.
REVIEW_DIFF_LIMIT=30000

# -----------------------------------------------------------------------------
# Tool behaviour
# -----------------------------------------------------------------------------
# auto  = simulate a service only when its own credentials are missing (default)
# true  = simulate every external service; no network calls, no real writes
# false = always call the real service, and fail loudly without credentials
TOOLS_DRY_RUN=auto

HTTP_TIMEOUT=30
